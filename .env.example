# LLM provider keys
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# lensllm optional settings
LENSLLM_DB_PATH=lensllm.db
LENSLLM_DASHBOARD_PORT=8080

# Production Storage (Postgres + pgvector for cache & metrics, Redis for rate limits)
# POSTGRES_URL=postgresql://lensllm:lensllm@localhost:5432/gateway
# LENSLLM_REDIS_URL=redis://localhost:6379

# Alerting (optional)
GATEWAY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
