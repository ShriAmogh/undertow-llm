# LLM provider keys
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# undertow-llm SDK settings
UNDERTOW_LLM_DB_PATH=undertow-llm.db
UNDERTOW_LLM_DASHBOARD_PORT=8080

# Production Storage (Postgres + pgvector for vector cache & metrics, Redis for rate limiting)
# Set either UNDERTOW_LLM_POSTGRES_URL or POSTGRES_URL:
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/undertow_db
# UNDERTOW_LLM_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/undertow_db

# Set either UNDERTOW_LLM_REDIS_URL or REDIS_URL:
# REDIS_URL=redis://localhost:6379
# UNDERTOW_LLM_REDIS_URL=redis://localhost:6379

# Alerting (optional)
GATEWAY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
