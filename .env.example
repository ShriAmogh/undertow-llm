# LLM provider keys
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# undertow_llm optional settings
UNDERTOW_LLM_DB_PATH=undertow_llm.db
UNDERTOW_LLM_DASHBOARD_PORT=8080

# Production Storage (Postgres + pgvector for cache & metrics, Redis for rate limits)
# POSTGRES_URL=postgresql://undertow_llm:undertow_llm@localhost:5432/gateway
# UNDERTOW_LLM_REDIS_URL=redis://localhost:6379

# Alerting (optional)
GATEWAY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
